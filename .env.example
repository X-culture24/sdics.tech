# Django - Production Settings
DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-use-openssl-rand-base64-64
ALLOWED_HOSTS=sdics.tech,www.sdics.tech,206.81.28.246,localhost,127.0.0.1

# Database - PostgreSQL (local server, NOT Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sdics
DB_USER=sdics
DB_PASSWORD=change-me-to-a-strong-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600
USE_CONNECTION_POOL=False

# Redis/Celery (local server, NOT Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS - HTTPS production origins
CORS_ALLOWED_ORIGINS=https://sdics.tech,https://www.sdics.tech,http://localhost:3000,http://127.0.0.1:3000

# Citizen datasets
DATASETS_DIR=./datasets
IMPORT_BATCH_SIZE=5000

# SMS PIN delivery (Twilio) - fill if using SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (optional admin notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
