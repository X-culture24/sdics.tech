{
  "name": "sdics-officer-mobile",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "capacitor:add:android": "npx cap add android",
    "capacitor:sync": "npx cap sync android",
    "capacitor:open:android": "npx cap open android",
    "capacitor:copy": "npx cap copy android",
    "build:android": "npm run build && npm run capacitor:sync && echo 'Android project updated. Open in Android Studio to build APK.'",
    "apk:debug": "cd android && ./gradlew assembleDebug && echo 'APK: android/app/build/outputs/apk/debug/app-debug.apk'",
    "apk:release": "cd android && ./gradlew assembleRelease && echo 'APK: android/app/build/outputs/apk/release/app-release.apk'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@capacitor/cli": "^6.0.0"
  }
}
